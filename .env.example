# Copia este archivo a .env.local si necesitas cambiar valores locales. No pongas secretos reales en archivos versionados.

# Puerto local de PostgreSQL (docker compose)
ACADEMY_DB_PORT=5434

# API (formato de configuración de ASP.NET Core: "__" separa secciones)
ConnectionStrings__Academy=Host=localhost;Port=5434;Database=academy;Username=academy;Password=academy_dev_only
Platform__Name=Kunnskap
Database__MigrateOnStartup=true
# Orígenes permitidos por CORS, solo si el frontend se sirve desde otro dominio:
# Cors__AllowedOrigins__0=https://ejemplo.org

# Frontend (público: se incluye en el JavaScript del navegador)
VITE_PLATFORM_NAME=Kunnskap
# Obligatorio en cualquier despliegue público (AGPL-3.0, sección 13): URL https del código fuente de esta instancia.
# VITE_SOURCE_URL=https://github.com/<usuario>/<repositorio>
